pipeline {
    options { buildDiscarder(logRotator(numToKeepStr: '60')) }
    agent { label 'ubuntu-devops' }
    
    parameters {
        string(name: 'SDNs', defaultValue: 'SDN001', description: 'Comma-separated list of SDN versions')
    }

    stages {
        stage('CheckOutGit') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: 'main']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    submoduleCfg: [],
                    userRemoteConfigs: [[
                        credentialsId: 'laxman_github_token',
                        url: 'git@github.com:mhasrup/Spring-Boot-application.git'
                    ]]
                ])
            }
        }

        stage('SDNfixPack Automation') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'artifactory_cred', 
                    usernameVariable: 'ARTIFACTORY_USER', 
                    passwordVariable: 'ARTIFACTORY_PASS'
                )]) {
                    dir('ansible') {
                        script {
                            String[] SDNs = params.SDNs.split(",")
                            for(String SDN : SDNs) {
                                String trimmedSDN = SDN.trim()
                                sh "pwd"
                                sh """
                                    docker run --rm \
                                      -v \$WORKSPACE:\$WORKSPACE \
                                      -v /home/laxman:/home/laxman \
                                      -w \$WORKSPACE/ansible \
                                      -e ANSIBLE_FORCE_COLOR=true \
                                      cytopia/ansible:latest \
                                      ansible-playbook download_SDN_from_artifactory.yml \
                                        -e "sdn_version=${trimmedSDN}" \
                                        -e "artifactory_user=${ARTIFACTORY_USER}" \
                                        -e "artifactory_password=${ARTIFACTORY_PASS}"
                                """
                            }
                        }
                    }
                }
            }
        }
    }
}
