pipeline {
    agent { label 'ubuntu-devops' }

    parameters {
        string(name: 'SDN_VERSION', defaultValue: 'SDN001', description: 'SDN Version to download')
    }

    stages {
        stage('Run Ansible in Docker Container') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'artifactory_cred', 
                    usernameVariable: 'ARTIFACTORY_USER', 
                    passwordVariable: 'ARTIFACTORY_PASS'
                )]) 
                  dir('ansible') {
                    //wrap([$class: 'AnsiColorBuildWrapper', 'colorMapName': 'XTerm']) {
                        script {String[] SDNs = params.SDNs.split(",");
                            for(String SDN: SDNs){
                                sh "pwd"
                                sh "export ANSIBLE_FORCE_COLOR=true; ansible-playbook download_SDN_from_artifactory.yml --user=laxman --extra-vars sdn_version=${SDN} -e artifactory_user=${ARTIFACTORY_USER} -e artifactory_password=${ARTIFACTORY_PASS}"
                               // -extra-vars is_this_0B2=${params.OB2_or_PH1} -extra-vars workspace=${WORKSPACE}"
                              }
                        //}
                    }
                }
            }
        }
    }
}
