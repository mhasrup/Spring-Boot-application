pipeline {
agent { label 'ubuntu-devops' }
/*
    agent {

        docker {
            label 'ubuntu-devops'                   // Runs the container on your VM agent
            image 'cytopia/ansible:latest'          // Docker image with Ansible pre-installed
            args '-v /home/laxman:/home/laxman'     // Mounts host directories so Ansible can write to /home/laxman/SDN
        }
    }

    agent {
        dockerContainer {
            image 'cytopia/ansible:latest'
            label 'ubuntu-devops'
            args '-v /home/laxman:/home/laxman'
        }
    }
*/

    parameters {
        string(name: 'SDN_VERSION', defaultValue: 'SDN001', description: 'SDN Version to download')
    }

    stages {
        stage('Run Ansible inside Container') {
        agent {
                dockerContainer {
                    image 'cytopia/ansible:latest'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'artifactory_cred', 
                    usernameVariable: 'ARTIFACTORY_USER', 
                    passwordVariable: 'ARTIFACTORY_PASS'
                )]) {
                    sh '''
                        ansible-playbook download_sdn.yml \
                          -e "sdn_version=${SDN_VERSION}" \
                          -e "artifactory_user=${ARTIFACTORY_USER}" \
                          -e "artifactory_password=${ARTIFACTORY_PASS}"
                    '''
                }
            }
        }
    }
}
